#!/usr/bin/env python3
"""cl_offline_compiler (CTS interface) on the x86 PC: OpenCL C -> SPIR-V with clang-18 + llvm-spirv-18.
usage: cl_offline_compiler --source F --output F --cl-device-info F --mode spir-v -- [BUILD_OPTIONS...]"""
import os, shlex, subprocess, sys, tempfile
a = sys.argv[1:]
sep = a.index("--") if "--" in a else len(a)
opts, build = a[:sep], " ".join(a[sep + 1:])
kv = {}
i = 0
while i < len(opts):
    k = opts[i]
    if "=" in k: k, v = k.split("=", 1); i += 1
    else: v = opts[i + 1]; i += 2
    kv[k] = v
src, out, info, mode = kv["--source"], kv["--output"], kv.get("--cl-device-info"), kv.get("--mode", "spir-v")
if mode != "spir-v": sys.exit("only spir-v mode")
dev = {}
if info and os.path.exists(info):
    for l in open(info):
        if "=" in l and not l.startswith("#"):
            k, v = l.strip().split("=", 1); dev[k] = v.strip('"')
bits = dev.get("CL_DEVICE_ADDRESS_BITS", "64")
exts = dev.get("CL_DEVICE_EXTENSIONS", "").split()
R = os.path.expanduser("~/g5-work/m26/nativedeps/root")
env = dict(os.environ, LD_LIBRARY_PATH=R + "/usr/lib/x86_64-linux-gnu")
# CTS build options are clang driver/cc1 compatible for the usual -cl-* / -D / -I flags
bo = [o for o in shlex.split(build) if o not in ("-cl-kernel-arg-info",)]
std = [o for o in bo if o.startswith("-cl-std=")]
bo = [o for o in bo if not o.startswith("-cl-std=")]
cl_std = std[-1] if std else "-cl-std=CL3.0"
if cl_std == "-cl-std=CL3.1": cl_std = "-cl-std=CL3.0"
ext = "-cl-ext=-all," + ",".join("+" + e for e in exts) if exts else None
with tempfile.TemporaryDirectory() as t:
    bc = os.path.join(t, "k.bc")
    cmd = ["clang-18", "-cc1", "-triple", "spir%s-unknown-unknown" % ("64" if bits == "64" else ""), cl_std,
           "-finclude-default-header", "-fdeclare-opencl-builtins", "-emit-llvm-bc", "-O0", "-o", bc]
    if ext: cmd.append(ext)
    if "-cl-kernel-arg-info" in build: cmd.append("-cl-kernel-arg-info")
    r = subprocess.run(cmd + bo + [src])
    if r.returncode: sys.exit(r.returncode)
    r = subprocess.run([R + "/usr/bin/llvm-spirv-18", "--spirv-ext=+all", bc, "-o", out], env=env)
    sys.exit(r.returncode)
