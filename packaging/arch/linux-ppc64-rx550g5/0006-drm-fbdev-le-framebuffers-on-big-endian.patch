+/*
+ * Big-endian hosts with drivers whose framebuffers use the little-endian DRM layouts
+ * (mode_config.allow_addfb2_le_formats_on_be): fbcon writes whole native 32-bit pixels, so
+ * describe the channels at the byte positions they occupy in a big-endian word
+ * (XRGB8888 in memory is B,G,R,X -> blue at bit 24, green 16, red 8).
+ */
+static void drm_fb_helper_le_formats_on_be(struct drm_device *dev, struct fb_var_screeninfo *var,
+					   const struct drm_format_info *format)
+{
+#ifdef __BIG_ENDIAN
+	if (!dev->mode_config.allow_addfb2_le_formats_on_be || format->cpp[0] != 4 ||
+	    (format->format & DRM_FORMAT_BIG_ENDIAN) || var->bits_per_pixel != 32)
+		return;
+	var->red.offset = 24 - var->red.offset;
+	var->green.offset = 24 - var->green.offset;
+	var->blue.offset = 24 - var->blue.offset;
+	if (var->transp.length)
+		var->transp.offset = 24 - var->transp.offset;
+#endif
+}
+
 static void drm_fb_helper_fill_pixel_fmt(struct fb_var_screeninfo *var,
 					 const struct drm_format_info *format)
 {
