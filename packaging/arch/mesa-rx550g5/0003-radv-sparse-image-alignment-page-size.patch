radv: align sparse images to at least the CPU page size

radv_amdgpu_bo_va_op() rounds mapping sizes up to getpagesize() (the kernel needs whole CPU
pages for some BOs). Sparse images reported a 4 KiB alignment, so with 64 KiB pages (Arch
POWER ppc64) a 4 KiB bind at offset 0x1000 became a 64 KiB mapping that overlapped the next
VA range (dmesg 'va ... conflict with ...'); the next BO map failed and
dEQP-VK.sparse_resources.* crashed. Sparse buffers already use 64 KiB. No change with 4 KiB pages.

--- a/src/amd/vulkan/radv_image.c
+++ b/src/amd/vulkan/radv_image.c
@@ -9,6 +9,7 @@
  */
 
 #include "radv_image.h"
+#include <unistd.h>
 #include "tools/radv_debug.h"
 #include "tools/radv_rmv.h"
 #include "util/u_atomic.h"
@@ -1552,7 +1553,9 @@
             replay_address = *((const uint64_t *)opaque_info->pData->address);
       }
 
-      image->alignment = MAX2(image->alignment, 4096);
+      /* The winsys maps sparse binds in whole CPU pages; with 64 KiB pages (some ppc64/arm64
+       * kernels) a 4 KiB bind alignment let binds overlap their neighbours. */
+      image->alignment = MAX2(image->alignment, MAX2(4096, getpagesize()));
       image->size = align64(image->size, image->alignment);
 
       result = radv_bo_create(device, &image->vk.base, image->size, image->alignment, 0, flags,
