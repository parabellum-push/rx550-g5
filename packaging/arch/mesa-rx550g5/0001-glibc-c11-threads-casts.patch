glibc >= 2.43 exposes native C11 threads (Mesa then defines HAVE_THRD_CREATE); its mtx_t/cnd_t
wrap the same storage as pthread_mutex_t/pthread_cond_t, but GCC 14+ rejects the implicit
pointer conversion. Build fix for Arch POWER (glibc 2.44, GCC 16); no behaviour change.

--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -2899,7 +2899,8 @@
       }
 #endif
 
-      ret = pthread_cond_init(&dri2_sync->cond, &attr);
+      /* glibc >= 2.43 native C11 threads: cnd_t wraps pthread_cond_t (Arch POWER build fix). */
+      ret = pthread_cond_init((pthread_cond_t *)&dri2_sync->cond, &attr);
 
       if (ret) {
          _eglError(EGL_BAD_ACCESS, "eglCreateSyncKHR");
--- a/src/util/cnd_monotonic.c
+++ b/src/util/cnd_monotonic.c
@@ -132,7 +132,9 @@
    timespec_sub_saturate(&rel_time, abs_time, &now_time);
    int rt = pthread_cond_timedwait_relative_np(&cond->cond, mtx, &rel_time);
 #else
-   int rt = pthread_cond_timedwait(&cond->cond, mtx, abs_time);
+   /* glibc >= 2.43 exposes native C11 threads (HAVE_THRD_CREATE); its mtx_t wraps the same
+    * storage as pthread_mutex_t, so the cast is valid. Arch POWER build fix (GCC 16). */
+   int rt = pthread_cond_timedwait(&cond->cond, (pthread_mutex_t *)mtx, abs_time);
 #endif
    if (rt == ETIMEDOUT)
       return thrd_timedout;
@@ -151,6 +153,6 @@
                             (PCRITICAL_SECTION)mtx, INFINITE);
    return thrd_success;
 #else
-   return (pthread_cond_wait(&cond->cond, mtx) == 0) ? thrd_success : thrd_error;
+   return (pthread_cond_wait(&cond->cond, (pthread_mutex_t *)mtx) == 0) ? thrd_success : thrd_error;
 #endif
 }
