# Mesa 26.2.6 with the big-endian GFX8 fixes (radeonsi, RADV, Rusticl) for the Radeon RX 550
# on a Power Mac G5, for Arch POWER ppc64 (big-endian, ELFv2).
# Source: branch g5-26 of https://github.com/parabellum-push/mesa-rx550-be (tag 26.2.6-1+rx550g5.3),
# the same commit as the Debian/MintPPC release rx550g5.3.
# Each package provides and conflicts with its Arch counterpart, so an Arch Mesa update does not
# silently replace the big-endian build. Remove these packages to return to stock Mesa.
# The release packages were cross-built on x86_64 (packaging/arch/cross/build-mesa.sh) with these
# sources and options; this PKGBUILD is the native recipe.

pkgbase=mesa-rx550g5
# mesa-rx550g5 must stay first: its package function splits out the files of the others.
pkgname=(mesa-rx550g5 vulkan-radeon-rx550g5 vulkan-swrast-rx550g5 vulkan-mesa-layers-rx550g5 opencl-mesa-rx550g5)
_tag=26.2.6-1+rx550g5.3
pkgver=26.2.6.rx550g5.3
pkgrel=1
epoch=1
pkgdesc='Mesa with big-endian fixes for the Radeon RX 550 (GFX8) on Power Mac G5'
url='https://github.com/parabellum-push/mesa-rx550-be'
arch=(powerpc64)
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(clang expat git glslang libclc libdrm libelf libglvnd libpng libva libx11 libxcb libxext
             libxfixes libxrandr libxshmfence libxxf86vm llvm llvm-libs lm_sensors meson python-mako
             python-packaging python-ply python-yaml rust rust-bindgen spirv-llvm-translator spirv-tools
             wayland wayland-protocols xorgproto zstd)
options=(!lto)
source=("mesa::git+https://github.com/parabellum-push/mesa-rx550-be.git#tag=${_tag}"
        0001-glibc-c11-threads-casts.patch
        0002-radv-host-pointer-alignment-page-size.patch
        0003-radv-sparse-image-alignment-page-size.patch
        0004-egl-wayland-dri-byte-layout-formats-on-big-endian.patch
        README.rx550-g5)
sha256sums=('SKIP'
            '2bd30d45c3c81a0a1b5e0fb93f45af5c2d7844a73da341798dd7bba8ff9468a2'
            'a31ff6fc57bda0a8f64a30cb1e5a146e0d3e6b3ce9c9322ae287b90ad07fbceb'
            '1102db560a9556369195065bcc192b4166c646a9d93865ee5f270e4ed3b42d81'
            '6e601b7983d03ef61501c70a12527959bc7d3ca87312d449c6d9fa5005466bf2'
            'e8993205cc338d31ee8416868fee1443577ba9d4ac87a5a07cc5992f3d2d28f4')

prepare() {
  cd mesa
  echo "26.2.6-1.rx550g5.3" > VERSION
  patch -Np1 < ../0001-glibc-c11-threads-casts.patch
  patch -Np1 < ../0002-radv-host-pointer-alignment-page-size.patch
  patch -Np1 < ../0003-radv-sparse-image-alignment-page-size.patch
  patch -Np1 < ../0004-egl-wayland-dri-byte-layout-formats-on-big-endian.patch
}

build() {
  arch-meson mesa build \
    -D b_ndebug=true \
    -D platforms=x11,wayland \
    -D gallium-drivers=softpipe,llvmpipe,nouveau,r300,r600,radeonsi,virgl,zink \
    -D vulkan-drivers=amd,swrast \
    -D vulkan-layers=anti-lag,device-select,overlay,screenshot -D vulkan-manifest-per-architecture=false \
    -D glvnd=enabled -D gbm=enabled -D gles1=disabled -D gles2=enabled -D glx-direct=true \
    -D gallium-extra-hud=true -D lmsensors=enabled -D gallium-va=enabled -D video-codecs=all \
    -D llvm=enabled -D shared-llvm=enabled \
    -D gallium-rusticl=true -D gallium-rusticl-enable-drivers=radeonsi \
    -D mesa-clc=system -D mesa-clc-bundle-headers=enabled \
    -D valgrind=disabled -D libunwind=disabled -D teflon=false -D android-libbacktrace=disabled \
    -D build-tests=false -D tools=[]
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
  done
}

package_vulkan-radeon-rx550g5() {
  pkgdesc='Big-endian RADV (Radeon Vulkan) for the RX 550 on Power Mac G5'
  depends=(expat libdrm libelf libx11 libxcb libxshmfence llvm-libs systemd-libs vulkan-icd-loader wayland zstd)
  provides=(vulkan-radeon=1:26.2.6 vulkan-driver)
  conflicts=(vulkan-radeon)
  mv "$srcdir"/vkradeon/* "$pkgdir"
  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-swrast-rx550g5() {
  pkgdesc='Vulkan software rasterizer (lavapipe) from the RX 550 G5 Mesa build'
  depends=(expat libdrm libx11 libxcb libxshmfence llvm-libs systemd-libs vulkan-icd-loader wayland zstd)
  provides=(vulkan-swrast=1:26.2.6 vulkan-driver)
  conflicts=(vulkan-swrast)
  mv "$srcdir"/vkswrast/* "$pkgdir"
  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-mesa-layers-rx550g5() {
  pkgdesc='Mesa Vulkan layers (device-select, overlay, screenshot, anti-lag) from the RX 550 G5 build'
  depends=(libdrm libpng libxcb wayland)
  provides=(vulkan-mesa-layers=1:26.2.6 vulkan-mesa-implicit-layers=1:26.2.6)
  conflicts=(vulkan-mesa-layers vulkan-mesa-implicit-layers)
  mv "$srcdir"/vklayer/* "$pkgdir"
  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_opencl-mesa-rx550g5() {
  pkgdesc='Big-endian Rusticl (OpenCL) on radeonsi for the RX 550 on Power Mac G5'
  depends=(clang expat libclc libdrm libelf llvm-libs mesa-rx550g5 spirv-llvm-translator spirv-tools zstd)
  provides=(opencl-mesa=1:26.2.6 opencl-driver)
  conflicts=(opencl-mesa)
  mv "$srcdir"/opencl/* "$pkgdir"
  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_mesa-rx550g5() {
  depends=(expat libdrm libelf libglvnd libx11 libxcb libxext libxshmfence libxxf86vm llvm-libs
           lm_sensors spirv-tools wayland zlib zstd)
  optdepends=('opengl-man-pages: for the OpenGL API man pages')
  provides=(mesa=1:26.2.6 libva-mesa-driver=1:26.2.6 mesa-vdpau=1:26.2.6 mesa-libgl=1:26.2.6
            libva-driver opengl-driver)
  conflicts=(mesa libva-mesa-driver mesa-vdpau mesa-libgl)

  meson install -C build --destdir "$pkgdir"

  # split out the other packages (order matters: the json files name the libraries)
  cd "$pkgdir"
  _pick vkradeon usr/lib/libvulkan_radeon.so usr/share/vulkan/icd.d/radeon_icd*.json usr/share/drirc.d/00-radv-defaults.conf
  _pick vkswrast usr/lib/libvulkan_lvp.so usr/share/vulkan/icd.d/lvp_icd*.json
  _pick vklayer usr/lib/libVkLayer_*.so usr/share/vulkan/explicit_layer.d usr/share/vulkan/implicit_layer.d usr/bin/mesa-overlay-control.py
  _pick opencl etc/OpenCL usr/lib/libRusticlOpenCL*
  cd "$srcdir"

  # libglvnd provides the GL/EGL/GLES front ends
  rm -f "$pkgdir"/usr/lib/libGLESv{1_CM,2}.so* 2>/dev/null || true
  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.rx550-g5 -t "$pkgdir/usr/share/doc/$pkgname"
}
