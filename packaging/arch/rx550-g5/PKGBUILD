            '764cfe4e8ee1873c73f844ecbd516ecaff8b618baeb0f8a58a9734e79a010292')

package() {
  install -Dm644 modprobe.conf "$pkgdir/usr/lib/modprobe.d/rx550-g5.conf"
  install -Dm644 modules-load.conf "$pkgdir/usr/lib/modules-load.d/rx550-g5.conf"
  install -Dm755 load-module enable-output update-grub -t "$pkgdir/usr/lib/rx550-g5"
  install -Dm644 rx550-g5.service rx550-g5-hotplug.service -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 90-rx550-g5-hotplug.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 95-rx550-g5-grub.hook -t "$pkgdir/usr/share/libalpm/hooks"
  install -Dm644 20-rx550-g5.conf -t "$pkgdir/usr/share/X11/xorg.conf.d"
  install -Dm644 grub.cfg "$pkgdir/etc/default/grub.d/90-rx550-g5.cfg"
  install -Dm644 README -t "$pkgdir/usr/share/doc/rx550-g5"
  install -Dm644 no-suspend.conf "$pkgdir/usr/lib/systemd/sleep.conf.d/90-rx550-g5-no-suspend.conf"
}
